From d644a41cc41bc7fcba2fce58d2358c528bda6bb6 Mon Sep 17 00:00:00 2001
From: Drive Player <drive-player@localhost>
Date: Sun, 11 Oct 2026 05:50:42 +0900
Subject: [PATCH] decoder: complete paused preroll after accepting a video
 picture

Compressed buffering duration does not include a decoder's reordering
and frame-thread latency. Completing buffering while paused can stop
demuxing with no valid picture and an empty video FIFO. A stopped SH-02M
HEVC seek retained frames_countdown=1, b_first=true, no decoder error,
and an idle empty FIFO; the input was waiting for another command.

Poll the decoder's first-video state without waiting, and keep feeding
paused preroll with a pending one-picture request until a picture passes
the decoder's presentation checks. A paused open with no picture request
retains its existing buffering completion. Keep the public buffering fraction below completion until then.
Playing inputs, audio-only buffering and forced EOF completion retain
their existing paths. Do not change pause, clock origins or codec APIs.

A strict requested PTS also excludes the final picture of an ended MP4:
the target can fall at the end of the last access unit's display interval.
Retain the original request separately, enable its presentation boundary
when dated access units provide positive durations, and admit the unit
covering that request. Apply this after packetization, not to aggregate
transport packets. Unknown access-unit durations keep legacy preroll.

Retain the boundary across buffering completion and delayed reordered
output. Only the next flush request clears it; later packets cannot
progressively move the original target backwards. No packet timestamp,
MediaCodec timeout, first-picture request or audio preroll is rewritten.
---
 src/input/decoder.c | 58 +++++++++++++++++++++++++++++++++++++++++----
 src/input/decoder.h | 13 ++++++++--
 src/input/es_out.c  | 26 +++++++++++++++++++-
 3 files changed, 90 insertions(+), 7 deletions(-)

diff --git a/src/input/decoder.c b/src/input/decoder.c
index f98656d..a8264d9 100644
--- a/src/input/decoder.c
+++ b/src/input/decoder.c
@@ -112,9 +112,11 @@ struct decoder_owner_sys_t
     /* -- Theses variables need locking on read *and* write -- */
     /* Preroll */
     int64_t i_preroll_end;
-    /* Explicit video display boundary, protected by lock. It survives the
-     * asynchronous codec flush; only a new flush request resets it. */
+    /* Explicit video target and its access-unit display boundary, protected
+     * by lock. They survive the asynchronous codec flush; only a new flush
+     * request resets them. */
     vlc_tick_t i_video_preroll_end;
+    vlc_tick_t i_video_preroll_target;
     /* Pause */
     vlc_tick_t pause_date;
     unsigned frames_countdown;
@@ -1463,6 +1465,32 @@ static void DecoderDecode( decoder_t *p_dec, block_t *p_block )
 {
     decoder_owner_sys_t *p_owner = p_dec->p_owner;
 
+    if( p_dec->fmt_in.i_cat == VIDEO_ES && p_dec->fmt_in.b_packetized
+     && p_block != NULL
+     && p_block->i_pts > VLC_TICK_INVALID && p_block->i_length > 0 )
+    {
+        /* The requested time may fall inside a picture's display interval,
+         * including the last picture when recovering an ended video. Use an
+         * access unit after packetization: a transport packet can contain
+         * several pictures and its duration cannot identify the right one.
+         * Keep the original target so later reordered packets cannot move
+         * the boundary backwards again. Without known access-unit durations,
+         * keep legacy preroll instead of imposing an unprovable PTS boundary. */
+        vlc_mutex_lock( &p_owner->lock );
+        vlc_tick_t target = p_owner->i_video_preroll_target;
+        if( target > VLC_TICK_INVALID )
+        {
+            if( p_owner->i_video_preroll_end == VLC_TICK_INVALID )
+                p_owner->i_video_preroll_end = target;
+            if( !(p_block->i_flags & BLOCK_FLAG_PREROLL)
+             && p_block->i_pts <= target
+             && target - p_block->i_pts <= p_block->i_length )
+                p_owner->i_video_preroll_end =
+                    __MIN( p_owner->i_video_preroll_end, p_block->i_pts );
+        }
+        vlc_mutex_unlock( &p_owner->lock );
+    }
+
     int ret = p_dec->pf_decode( p_dec, p_block );
     switch( ret )
     {
@@ -1803,6 +1831,7 @@ static decoder_t * CreateDecoder( vlc_object_t *p_parent,
     }
     p_owner->i_preroll_end = INT64_MIN;
     p_owner->i_video_preroll_end = VLC_TICK_INVALID;
+    p_owner->i_video_preroll_target = VLC_TICK_INVALID;
     p_owner->i_last_rate = INPUT_RATE_DEFAULT;
     p_owner->p_input = p_input;
     p_owner->p_resource = p_resource;
@@ -2278,6 +2307,7 @@ void input_DecoderFlush( decoder_t *p_dec )
      * acknowledge the new cycle only after the codec and vout have flushed. */
     vlc_mutex_lock( &p_owner->lock );
     p_owner->i_video_preroll_end = VLC_TICK_INVALID;
+    p_owner->i_video_preroll_target = VLC_TICK_INVALID;
     if( p_owner->b_waiting )
     {
         p_owner->b_first = true;
@@ -2296,8 +2326,11 @@ void input_DecoderSetVideoPreroll( decoder_t *p_dec, vlc_tick_t i_date )
     vlc_mutex_lock( &p_owner->lock );
     /* DTS and packet flags cannot express a presentation boundary for
      * reordered pictures. Keep the demuxer's target until the next seek,
-     * including after buffering ends and delayed pictures arrive. */
-    p_owner->i_video_preroll_end = i_date;
+     * including after buffering ends and delayed pictures arrive. A dated
+     * access unit with a known duration enables the boundary and may lower it
+     * to the picture covering the target. */
+    p_owner->i_video_preroll_end = VLC_TICK_INVALID;
+    p_owner->i_video_preroll_target = i_date;
     vlc_mutex_unlock( &p_owner->lock );
 }
 
@@ -2452,6 +2485,23 @@ void input_DecoderStopWait( decoder_t *p_dec )
     vlc_mutex_unlock( &p_owner->lock );
 }
 
+bool input_DecoderIsWaitingForFirstVideo( decoder_t *p_dec )
+{
+    if( p_dec->fmt_in.i_cat != VIDEO_ES )
+        return false;
+
+    decoder_owner_sys_t *p_owner = p_dec->p_owner;
+    vlc_mutex_lock( &p_owner->lock );
+    vlc_fifo_Lock( p_owner->p_fifo );
+    /* A decoder opened paused can have no picture request at all. Its input
+     * must be allowed to finish buffering without waiting for video output. */
+    bool waiting = p_owner->b_waiting && p_owner->b_first
+                && p_owner->paused && p_owner->frames_countdown > 0;
+    vlc_fifo_Unlock( p_owner->p_fifo );
+    vlc_mutex_unlock( &p_owner->lock );
+    return waiting;
+}
+
 void input_DecoderWait( decoder_t *p_dec )
 {
     decoder_owner_sys_t *p_owner = p_dec->p_owner;
diff --git a/src/input/decoder.h b/src/input/decoder.h
index e3baa2f..a40da26 100644
--- a/src/input/decoder.h
+++ b/src/input/decoder.h
@@ -44,8 +44,10 @@ void input_DecoderChangePause( decoder_t *, bool b_paused, vlc_tick_t i_date );
 void input_DecoderChangeDelay( decoder_t *, vlc_tick_t i_delay );
 
 /**
- * Set an accurate seek's minimum video presentation timestamp, in the demuxer's
- * stream clock. Call after requesting a flush and before sending new blocks.
+ * Set an accurate seek's video presentation target, in the demuxer's stream
+ * clock. Access units with known durations enable the presentation boundary;
+ * a dated access unit covering the target may supply its picture.
+ * Call after requesting a flush and before sending new blocks.
  * Audio and subtitle decoders are unaffected. The boundary survives codec
  * flushing and buffering completion and is reset by the next flush request.
  */
@@ -56,6 +58,13 @@ void input_DecoderSetVideoPreroll( decoder_t *, vlc_tick_t i_date );
  */
 void input_DecoderStartWait( decoder_t * );
 
+/**
+ * Whether buffering has yet to supply a pending paused video picture request.
+ * This does not wait: a paused demuxer must keep supplying input to decoders
+ * with delayed output. No request, audio and subtitle decoders return false.
+ */
+bool input_DecoderIsWaitingForFirstVideo( decoder_t * );
+
 /**
  * This function waits for the decoder to actually receive data.
  */
diff --git a/src/input/es_out.c b/src/input/es_out.c
index 7eda36c..e76a103 100644
--- a/src/input/es_out.c
+++ b/src/input/es_out.c
@@ -677,13 +677,37 @@ static void EsOutDecodersStopBuffering( es_out_t *out, bool b_forced )
                                          i_preroll_duration +
                                          p_sys->i_buffering_extra_stream - p_sys->i_buffering_extra_initial;
 
-    if( i_stream_duration <= i_buffering_duration && !b_forced )
+    /* A duration of compressed input does not guarantee a decoded picture.
+     * Once paused buffering ends, the demuxer stops sending input; reordered
+     * or threaded video can then wait forever for the rest of its preroll.
+     * Poll the first valid picture while still feeding input, rather than
+     * waiting here and starving the decoder. Forced completion at EOF and
+     * ordinary playback/audio buffering retain their existing behaviour. */
+    bool waiting_for_video = false;
+    if( p_sys->b_paused && !b_forced )
+    {
+        for( int i = 0; i < p_sys->i_es; i++ )
+        {
+            es_out_id_t *es = p_sys->es[i];
+            if( es->p_dec != NULL &&
+                input_DecoderIsWaitingForFirstVideo( es->p_dec ) )
+            {
+                waiting_for_video = true;
+                break;
+            }
+        }
+    }
+
+    if( (i_stream_duration <= i_buffering_duration || waiting_for_video)
+     && !b_forced )
     {
         double f_level;
         if (i_buffering_duration == 0)
             f_level = 0;
         else
             f_level = __MAX( (double)i_stream_duration / i_buffering_duration, 0 );
+        if( waiting_for_video )
+            f_level = __MIN( f_level, 0.99 );
         input_SendEventCache( p_sys->p_input, f_level );
 
         int i_level = (int)(100 * f_level);
-- 
2.55.0

