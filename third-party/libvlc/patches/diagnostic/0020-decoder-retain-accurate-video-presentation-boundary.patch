From 30b083c0847e0a68a598c1ce2229d77f65f786f8 Mon Sep 17 00:00:00 2001
From: Drive Player <drive-player@localhost>
Date: Sun, 11 Oct 2026 01:56:24 +0900
Subject: [PATCH] decoder: retain the accurate video presentation boundary
 across preroll

ES_OUT_SET_NEXT_DISPLAY_TIME currently marks packets as preroll but does
not deliver its timestamp to the decoder. DecoderUpdatePreroll derives
an output boundary from a non-preroll packet's DTS. With reordered HEVC
pictures, that DTS can precede the display target: the 4500 ms fixture
has a non-preroll frame 67 packet with DTS 4400 ms, allowing frame 66's
4400 ms PTS through when MediaCodec returns it after that packet.

Retain the demuxer's explicit target in the video decoder owner and
reject earlier picture PTS before first-picture forcing or buffering
acknowledgement. Keep the existing packet-derived preroll in addition;
audio, subtitles and seeks without an explicit target retain their
current handling. No packet timestamps or clock origins are rewritten.

The owner lock protects this boundary. A new flush request clears it
before the demuxer sets the next target. The asynchronous codec flush
must not erase a target already set for that seek, and buffering
completion must not let delayed reordered pictures escape it. Propagate
the target to video decoders created while preroll is active as well.

Also recheck the pending flush under the FIFO lock before consuming a
paused picture request. A seek arriving after timestamp conversion can
otherwise have that request consumed by an already accepted old picture.
MediaCodec holds its output mutex through decoder_QueueVideo, so its
codec flush cannot complete until that callback returns. Discard the old
picture before decrementing the new request; leave the decoder thread
responsible for completing the flush.
---
 src/input/decoder.c | 29 ++++++++++++++++++++++++++++-
 src/input/decoder.h |  8 ++++++++
 src/input/es_out.c  | 11 +++++++++++
 3 files changed, 47 insertions(+), 1 deletion(-)

diff --git a/src/input/decoder.c b/src/input/decoder.c
index 9832424..f98656d 100644
--- a/src/input/decoder.c
+++ b/src/input/decoder.c
@@ -112,6 +112,9 @@ struct decoder_owner_sys_t
     /* -- Theses variables need locking on read *and* write -- */
     /* Preroll */
     int64_t i_preroll_end;
+    /* Explicit video display boundary, protected by lock. It survives the
+     * asynchronous codec flush; only a new flush request resets it. */
+    vlc_tick_t i_video_preroll_end;
     /* Pause */
     vlc_tick_t pause_date;
     unsigned frames_countdown;
@@ -1064,7 +1067,8 @@ static int DecoderPlayVideo( decoder_t *p_dec, picture_t *p_picture,
     bool prerolled;
 
     vlc_mutex_lock( &p_owner->lock );
-    if( DecoderIsFlushing( p_owner ) || p_owner->i_preroll_end > p_picture->date )
+    if( DecoderIsFlushing( p_owner ) || p_owner->i_preroll_end > p_picture->date
+     || p_owner->i_video_preroll_end > p_picture->date )
     {
         vlc_mutex_unlock( &p_owner->lock );
         picture_Release( p_picture );
@@ -1131,6 +1135,13 @@ static int DecoderPlayVideo( decoder_t *p_dec, picture_t *p_picture,
     /* FIXME: The *input* FIFO should not be locked here. This will not work
      * properly if/when pictures are queued asynchronously. */
     vlc_fifo_Lock( p_owner->p_fifo );
+    /* A seek can arrive after timestamp conversion. Do not spend its paused
+     * picture request on output from the previous timeline. */
+    if( unlikely(p_owner->flushing) )
+    {
+        vlc_fifo_Unlock( p_owner->p_fifo );
+        goto discard;
+    }
     if( unlikely(p_owner->paused) && likely(p_owner->frames_countdown > 0) )
     {
         /* Buffering may have stopped waiting before this paused seek/step
@@ -1791,6 +1802,7 @@ static decoder_t * CreateDecoder( vlc_object_t *p_parent,
         return NULL;
     }
     p_owner->i_preroll_end = INT64_MIN;
+    p_owner->i_video_preroll_end = VLC_TICK_INVALID;
     p_owner->i_last_rate = INPUT_RATE_DEFAULT;
     p_owner->p_input = p_input;
     p_owner->p_resource = p_resource;
@@ -2265,6 +2277,7 @@ void input_DecoderFlush( decoder_t *p_dec )
     /* Release callbacks waiting on the old buffering cycle. Fresh output can
      * acknowledge the new cycle only after the codec and vout have flushed. */
     vlc_mutex_lock( &p_owner->lock );
+    p_owner->i_video_preroll_end = VLC_TICK_INVALID;
     if( p_owner->b_waiting )
     {
         p_owner->b_first = true;
@@ -2274,6 +2287,20 @@ void input_DecoderFlush( decoder_t *p_dec )
     vlc_mutex_unlock( &p_owner->lock );
 }
 
+void input_DecoderSetVideoPreroll( decoder_t *p_dec, vlc_tick_t i_date )
+{
+    if( p_dec->fmt_in.i_cat != VIDEO_ES )
+        return;
+
+    decoder_owner_sys_t *p_owner = p_dec->p_owner;
+    vlc_mutex_lock( &p_owner->lock );
+    /* DTS and packet flags cannot express a presentation boundary for
+     * reordered pictures. Keep the demuxer's target until the next seek,
+     * including after buffering ends and delayed pictures arrive. */
+    p_owner->i_video_preroll_end = i_date;
+    vlc_mutex_unlock( &p_owner->lock );
+}
+
 void input_DecoderGetCcDesc( decoder_t *p_dec, decoder_cc_desc_t *p_desc )
 {
     decoder_owner_sys_t *p_owner = p_dec->p_owner;
diff --git a/src/input/decoder.h b/src/input/decoder.h
index 5b39e3e..e3baa2f 100644
--- a/src/input/decoder.h
+++ b/src/input/decoder.h
@@ -43,6 +43,14 @@ void input_DecoderChangePause( decoder_t *, bool b_paused, vlc_tick_t i_date );
  */
 void input_DecoderChangeDelay( decoder_t *, vlc_tick_t i_delay );
 
+/**
+ * Set an accurate seek's minimum video presentation timestamp, in the demuxer's
+ * stream clock. Call after requesting a flush and before sending new blocks.
+ * Audio and subtitle decoders are unaffected. The boundary survives codec
+ * flushing and buffering completion and is reset by the next flush request.
+ */
+void input_DecoderSetVideoPreroll( decoder_t *, vlc_tick_t i_date );
+
 /**
  * This function makes the decoder start waiting for a valid data block from its fifo.
  */
diff --git a/src/input/es_out.c b/src/input/es_out.c
index c8331bf..7eda36c 100644
--- a/src/input/es_out.c
+++ b/src/input/es_out.c
@@ -1680,6 +1680,8 @@ static void EsCreateDecoder( es_out_t *out, es_out_id_t *p_es )
     p_es->p_dec = input_DecoderNew( p_input, &p_es->fmt, p_es->p_pgrm->p_clock, input_priv(p_input)->p_sout );
     if( p_es->p_dec )
     {
+        if( p_sys->i_preroll_end >= 0 )
+            input_DecoderSetVideoPreroll( p_es->p_dec, p_sys->i_preroll_end );
         if( p_sys->b_buffering )
             input_DecoderStartWait( p_es->p_dec );
         /* A decoder made while the input is paused starts paused, as the
@@ -2640,6 +2642,15 @@ static int EsOutControlLocked( es_out_t *out, int i_query, va_list args )
 
         p_sys->i_preroll_end = i_date;
 
+        /* Packet preroll flags remain useful for audio and undated input, but
+         * their DTS-derived decoder boundary is too early for B pictures.
+         * Deliver the explicit presentation target before new video blocks. */
+        for( int i = 0; i < p_sys->i_es; i++ )
+        {
+            if( p_sys->es[i]->p_dec != NULL )
+                input_DecoderSetVideoPreroll( p_sys->es[i]->p_dec, i_date );
+        }
+
         return VLC_SUCCESS;
     }
     case ES_OUT_SET_GROUP_META:
-- 
2.55.0

