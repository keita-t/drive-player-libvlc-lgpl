From 16850c7546dff03dfcf3f152527b50eb5412758e Mon Sep 17 00:00:00 2001
From: Drive Player <drive-player@localhost>
Date: Sun, 11 Oct 2026 12:09:36 +0900
Subject: [PATCH] decoder: preserve DTS-only preroll and cancel obsolete drain
 requests

Native23 reversed only the MediaCodec part of0018 against the22 core.
The identical19-condition comparison passed12 and failed7: H.264 EOF3
and backward-seek progression3 still failed, and silent HEVC progression
also stopped. Paused seek/resume6 and strict HEVC marker4 passed. H.264
with sound in MP4 passed once, so this run does not establish individual
hunk causality or exonerate all MediaCodec interactions.19 passed all
seven H.264 conditions that failed22 with the same119 fixtures.

Keep the existing presentation fallback for packetized units without
PTS unless earlier PTS/DTS evidence established reordering. A valid PTS
enables the explicit boundary; reordered video keeps the strict target
and the paused readiness/clock protocol of0022.

Flush cancels the discarded input timeline's pending drain with its FIFO
blocks. Reset its completion marker under the owner lock and complete a
null-block drain only under owner then FIFO locking without a pending
flush. The same decoder thread handles codec flushing after an interrupted
drain returns. Keep0018's MediaCodec queue guards and interruptible wait:
the diagnostic reversal is omitted from this corrective recipe.

No app control, fixture, assertion, codec whitelist or frame-rate heuristic
is changed. This is an unbuilt, unaccepted candidate: runtime effects and
other-format safety remain to be verified. The user performs native builds;
stop before compilation.
---
 src/input/decoder.c | 65 ++++++++++++++++++++++++++++-----------------
 src/input/decoder.h |  6 +++--
 2 files changed, 44 insertions(+), 27 deletions(-)

diff --git a/src/input/decoder.c b/src/input/decoder.c
index 031a443..e212184 100644
--- a/src/input/decoder.c
+++ b/src/input/decoder.c
@@ -1485,16 +1485,17 @@ static void DecoderDecode( decoder_t *p_dec, block_t *p_block )
     decoder_owner_sys_t *p_owner = p_dec->p_owner;
 
     if( p_dec->fmt_in.i_cat == VIDEO_ES && p_dec->fmt_in.b_packetized
-     && p_block != NULL && p_block->i_pts > VLC_TICK_INVALID )
-    {
-        /* Unit duration alone cannot identify the display interval when
-         * decode and presentation order differ. With matching PTS
-         * and DTS and no reordering observed, the unit covering the request
-         * is also its displayed picture, including the final unit at EOF.
-         * Unknown timestamps or durations keep the strict requested boundary.
-         * Inspect units after packetization, never aggregate TS packets. */
+     && p_block != NULL )
+    {
+        /* Inspect access units, never aggregate transport packets. Some
+         * packetized inputs omit PTS and use the existing DTS presentation
+         * fallback. Keep legacy preroll for those units unless reordering has
+         * established that DTS cannot bound their displayed pictures. A known
+         * PTS enables the explicit boundary; matching PTS/DTS and a positive
+         * duration may admit the picture covering the requested interval. */
         vlc_mutex_lock( &p_owner->lock );
-        if( p_block->i_dts > VLC_TICK_INVALID &&
+        if( p_block->i_pts > VLC_TICK_INVALID &&
+            p_block->i_dts > VLC_TICK_INVALID &&
             p_block->i_pts != p_block->i_dts )
             p_owner->b_video_timestamp_reordered = true;
 
@@ -1503,14 +1504,21 @@ static void DecoderDecode( decoder_t *p_dec, block_t *p_block )
         {
             if( p_owner->b_video_timestamp_reordered )
                 p_owner->i_video_preroll_end = target;
-            else if( !(p_block->i_flags & BLOCK_FLAG_PREROLL)
-                  && p_block->i_dts > VLC_TICK_INVALID
-                  && p_block->i_pts == p_block->i_dts
-                  && p_block->i_length > 0
-                  && p_block->i_pts <= target
-                  && target - p_block->i_pts <= p_block->i_length )
-                p_owner->i_video_preroll_end =
-                    __MIN( p_owner->i_video_preroll_end, p_block->i_pts );
+            else if( p_block->i_pts <= VLC_TICK_INVALID )
+                p_owner->i_video_preroll_end = VLC_TICK_INVALID;
+            else
+            {
+                if( p_owner->i_video_preroll_end == VLC_TICK_INVALID )
+                    p_owner->i_video_preroll_end = target;
+                if( !(p_block->i_flags & BLOCK_FLAG_PREROLL)
+                 && p_block->i_dts > VLC_TICK_INVALID
+                 && p_block->i_pts == p_block->i_dts
+                 && p_block->i_length > 0
+                 && p_block->i_pts <= target
+                 && target - p_block->i_pts <= p_block->i_length )
+                    p_owner->i_video_preroll_end =
+                        __MIN( p_owner->i_video_preroll_end, p_block->i_pts );
+            }
         }
         vlc_mutex_unlock( &p_owner->lock );
     }
@@ -1812,12 +1820,15 @@ static void *DecoderThread( void *p_data )
 
         /* TODO? Wait for draining instead of polling. */
         vlc_mutex_lock( &p_owner->lock );
-        if( p_owner->b_draining && (p_block == NULL) )
+        vlc_fifo_Lock( p_owner->p_fifo );
+        /* A flush cancels the old EOS. Its interrupted completion must not
+         * acknowledge a drain requested for the next input timeline. The same
+         * decoder thread processes the codec flush after returning here. */
+        if( p_owner->b_draining && (p_block == NULL) && !p_owner->flushing )
         {
             p_owner->b_draining = false;
             p_owner->drained = true;
         }
-        vlc_fifo_Lock( p_owner->p_fifo );
         vlc_cond_signal( &p_owner->wait_acknowledge );
         vlc_mutex_unlock( &p_owner->lock );
     }
@@ -2309,6 +2320,9 @@ void input_DecoderFlush( decoder_t *p_dec )
 
     /* Empty the fifo */
     block_ChainRelease( vlc_fifo_DequeueAllUnlocked( p_owner->p_fifo ) );
+    /* The discarded timeline's EOF must not inject EOS when the new seek's
+     * FIFO temporarily empties before more compressed input arrives. */
+    p_owner->b_draining = false;
 
     /* Don't need to wait for the DecoderThread to flush. Indeed, if called a
      * second time, this function will clear the FIFO again before anything was
@@ -2333,6 +2347,7 @@ void input_DecoderFlush( decoder_t *p_dec )
     vlc_mutex_lock( &p_owner->lock );
     p_owner->i_video_preroll_end = VLC_TICK_INVALID;
     p_owner->i_video_preroll_target = VLC_TICK_INVALID;
+    p_owner->drained = false;
     if( p_owner->b_waiting )
     {
         p_owner->b_first = true;
@@ -2349,12 +2364,12 @@ void input_DecoderSetVideoPreroll( decoder_t *p_dec, vlc_tick_t i_date )
 
     decoder_owner_sys_t *p_owner = p_dec->p_owner;
     vlc_mutex_lock( &p_owner->lock );
-    /* DTS and packet flags cannot express a presentation boundary for
-     * reordered pictures. Keep the demuxer's target until the next seek,
-     * including after buffering ends and delayed pictures arrive. A dated
-     * access unit with a known duration enables the boundary and may lower it
-     * to the picture covering the target. */
-    p_owner->i_video_preroll_end = i_date;
+    /* DTS alone cannot bound reordered presentation. Known reordering makes
+     * the target strict immediately; otherwise an access unit with a valid
+     * PTS enables it. DTS-only units keep their existing presentation fallback.
+     * Retain the original target through buffering and asynchronous output. */
+    p_owner->i_video_preroll_end = p_owner->b_video_timestamp_reordered
+                                ? i_date : VLC_TICK_INVALID;
     p_owner->i_video_preroll_target = i_date;
     vlc_mutex_unlock( &p_owner->lock );
 }
diff --git a/src/input/decoder.h b/src/input/decoder.h
index a2d365b..916d799 100644
--- a/src/input/decoder.h
+++ b/src/input/decoder.h
@@ -45,8 +45,10 @@ void input_DecoderChangeDelay( decoder_t *, vlc_tick_t i_delay );
 
 /**
  * Set an accurate seek's video presentation target, in the demuxer's stream
- * clock. The boundary is strict unless a dated, non-reordered access unit
- * with a known duration supplies the picture covering that target.
+ * clock. A valid access-unit PTS enables the boundary; known reordering
+ * makes it strict immediately. DTS-only units retain legacy preroll unless
+ * reordering was observed. A non-reordered unit with matching PTS/DTS and a
+ * known duration may supply the picture covering the target.
  * Call after requesting a flush and before sending new blocks.
  * Audio and subtitle decoders are unaffected. The boundary survives codec
  * flushing and buffering completion and is reset by the next flush request.
-- 
