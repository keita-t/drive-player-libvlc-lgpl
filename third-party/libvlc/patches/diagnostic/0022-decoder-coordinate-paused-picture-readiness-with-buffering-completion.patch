From 3743ccd54907a85b494d0fbc509c557f04e8c994 Mon Sep 17 00:00:00 2001
From: Drive Player <drive-player@localhost>
Date: Sun, 11 Oct 2026 07:54:33 +0900
Subject: [PATCH] decoder: coordinate paused picture readiness with buffering
 completion

A requested paused picture must acknowledge readiness before converting
its PTS. Release it through the existing StopWait only after input has
established the buffering clock origin. Share the owner-to-FIFO guarded
picture-budget predicate between readiness polling and the callback.

Native 21 on SH-02M retained paused buffering and b_waiting=true after
its first HEVC picture while master EOF was already true. Paused input
then stopped demuxing and waited indefinitely for a control command.
Force the existing buffering completion when paused video reaches EOS;
there will be no later PCR to do it. Playback and audio-only EOS paths
retain their ordinary handling. No polling timer or pause/resume is added.

Native 21 also lowered a 3500000 presentation target to 3466667 and showed
marker 51 instead of 52..53. Always establish the requested boundary.
Only packetized units with valid matching PTS/DTS, positive duration and
no observed reordering may admit the picture covering the original
request, including its final-unit endpoint. Preserve reordering evidence
across seeks, and restore the target if later units establish reordering.
Unknown durations retain the strict boundary instead of legacy fallback.

The candidate is unbuilt and unaccepted. Native 21 is withheld after a
silent H.264 MP4 seek regression: identical fixtures and journey passed
on native 17/19 but stopped progressing on 21. Existing exact-marker,
all-format journey, paused seek/resume and EOF reattach tests remain the
acceptance boundary. The user runs native compilation after review.
---
 src/input/decoder.c | 66 ++++++++++++++++++++++++++++++---------------
 src/input/decoder.h |  8 +++---
 src/input/es_out.c  | 14 +++++++++-
 3 files changed, 63 insertions(+), 25 deletions(-)

diff --git a/src/input/decoder.c b/src/input/decoder.c
index a8264d9..031a443 100644
--- a/src/input/decoder.c
+++ b/src/input/decoder.c
@@ -117,6 +117,9 @@ struct decoder_owner_sys_t
      * request resets them. */
     vlc_tick_t i_video_preroll_end;
     vlc_tick_t i_video_preroll_target;
+    /* A decode-order duration cannot bound reordered presentation. Keep this
+     * evidence across seeks in the same decoder. Protected by lock. */
+    bool b_video_timestamp_reordered;
     /* Pause */
     vlc_tick_t pause_date;
     unsigned frames_countdown;
@@ -785,6 +788,17 @@ bool decoder_IsFlushing( decoder_t *p_dec )
     return p_dec->p_owner != NULL && DecoderIsFlushing( p_dec->p_owner );
 }
 
+/* The owner lock protects the wait state; the FIFO lock protects the paused
+ * picture budget. Release the FIFO before any decoder wait. */
+static bool DecoderHasPausedVideoRequest( decoder_owner_sys_t *p_owner )
+{
+    vlc_assert_locked( &p_owner->lock );
+    vlc_fifo_Lock( p_owner->p_fifo );
+    bool pending = p_owner->paused && p_owner->frames_countdown > 0;
+    vlc_fifo_Unlock( p_owner->p_fifo );
+    return pending;
+}
+
 static bool DecoderWaitUnblock( decoder_t *p_dec )
 {
     decoder_owner_sys_t *p_owner = p_dec->p_owner;
@@ -1106,7 +1120,12 @@ static int DecoderPlayVideo( decoder_t *p_dec, picture_t *p_picture,
         goto discard;
     }
 
-    if( p_owner->b_waiting && !p_owner->b_first )
+    /* A requested paused picture must acknowledge readiness before its
+     * timestamp is converted. Input can then finish buffering and set the
+     * clock origin before StopWait releases this callback. Sending it early
+     * lets later pictures use a different origin from the forced first one. */
+    if( p_owner->b_waiting &&
+        (!p_owner->b_first || DecoderHasPausedVideoRequest( p_owner )) )
     {
         p_owner->b_has_data = true;
         vlc_cond_signal( &p_owner->wait_acknowledge );
@@ -1466,25 +1485,30 @@ static void DecoderDecode( decoder_t *p_dec, block_t *p_block )
     decoder_owner_sys_t *p_owner = p_dec->p_owner;
 
     if( p_dec->fmt_in.i_cat == VIDEO_ES && p_dec->fmt_in.b_packetized
-     && p_block != NULL
-     && p_block->i_pts > VLC_TICK_INVALID && p_block->i_length > 0 )
-    {
-        /* The requested time may fall inside a picture's display interval,
-         * including the last picture when recovering an ended video. Use an
-         * access unit after packetization: a transport packet can contain
-         * several pictures and its duration cannot identify the right one.
-         * Keep the original target so later reordered packets cannot move
-         * the boundary backwards again. Without known access-unit durations,
-         * keep legacy preroll instead of imposing an unprovable PTS boundary. */
+     && p_block != NULL && p_block->i_pts > VLC_TICK_INVALID )
+    {
+        /* Unit duration alone cannot identify the display interval when
+         * decode and presentation order differ. With matching PTS
+         * and DTS and no reordering observed, the unit covering the request
+         * is also its displayed picture, including the final unit at EOF.
+         * Unknown timestamps or durations keep the strict requested boundary.
+         * Inspect units after packetization, never aggregate TS packets. */
         vlc_mutex_lock( &p_owner->lock );
+        if( p_block->i_dts > VLC_TICK_INVALID &&
+            p_block->i_pts != p_block->i_dts )
+            p_owner->b_video_timestamp_reordered = true;
+
         vlc_tick_t target = p_owner->i_video_preroll_target;
         if( target > VLC_TICK_INVALID )
         {
-            if( p_owner->i_video_preroll_end == VLC_TICK_INVALID )
+            if( p_owner->b_video_timestamp_reordered )
                 p_owner->i_video_preroll_end = target;
-            if( !(p_block->i_flags & BLOCK_FLAG_PREROLL)
-             && p_block->i_pts <= target
-             && target - p_block->i_pts <= p_block->i_length )
+            else if( !(p_block->i_flags & BLOCK_FLAG_PREROLL)
+                  && p_block->i_dts > VLC_TICK_INVALID
+                  && p_block->i_pts == p_block->i_dts
+                  && p_block->i_length > 0
+                  && p_block->i_pts <= target
+                  && target - p_block->i_pts <= p_block->i_length )
                 p_owner->i_video_preroll_end =
                     __MIN( p_owner->i_video_preroll_end, p_block->i_pts );
         }
@@ -1832,6 +1856,7 @@ static decoder_t * CreateDecoder( vlc_object_t *p_parent,
     p_owner->i_preroll_end = INT64_MIN;
     p_owner->i_video_preroll_end = VLC_TICK_INVALID;
     p_owner->i_video_preroll_target = VLC_TICK_INVALID;
+    p_owner->b_video_timestamp_reordered = false;
     p_owner->i_last_rate = INPUT_RATE_DEFAULT;
     p_owner->p_input = p_input;
     p_owner->p_resource = p_resource;
@@ -2329,7 +2354,7 @@ void input_DecoderSetVideoPreroll( decoder_t *p_dec, vlc_tick_t i_date )
      * including after buffering ends and delayed pictures arrive. A dated
      * access unit with a known duration enables the boundary and may lower it
      * to the picture covering the target. */
-    p_owner->i_video_preroll_end = VLC_TICK_INVALID;
+    p_owner->i_video_preroll_end = i_date;
     p_owner->i_video_preroll_target = i_date;
     vlc_mutex_unlock( &p_owner->lock );
 }
@@ -2492,12 +2517,11 @@ bool input_DecoderIsWaitingForFirstVideo( decoder_t *p_dec )
 
     decoder_owner_sys_t *p_owner = p_dec->p_owner;
     vlc_mutex_lock( &p_owner->lock );
-    vlc_fifo_Lock( p_owner->p_fifo );
-    /* A decoder opened paused can have no picture request at all. Its input
-     * must be allowed to finish buffering without waiting for video output. */
+    /* Readiness is acknowledged before clock conversion. A paused open with
+     * no picture request must still be allowed to complete ordinary buffering. */
     bool waiting = p_owner->b_waiting && p_owner->b_first
-                && p_owner->paused && p_owner->frames_countdown > 0;
-    vlc_fifo_Unlock( p_owner->p_fifo );
+                && !p_owner->b_has_data
+                && DecoderHasPausedVideoRequest( p_owner );
     vlc_mutex_unlock( &p_owner->lock );
     return waiting;
 }
diff --git a/src/input/decoder.h b/src/input/decoder.h
index a40da26..a2d365b 100644
--- a/src/input/decoder.h
+++ b/src/input/decoder.h
@@ -45,8 +45,8 @@ void input_DecoderChangeDelay( decoder_t *, vlc_tick_t i_delay );
 
 /**
  * Set an accurate seek's video presentation target, in the demuxer's stream
- * clock. Access units with known durations enable the presentation boundary;
- * a dated access unit covering the target may supply its picture.
+ * clock. The boundary is strict unless a dated, non-reordered access unit
+ * with a known duration supplies the picture covering that target.
  * Call after requesting a flush and before sending new blocks.
  * Audio and subtitle decoders are unaffected. The boundary survives codec
  * flushing and buffering completion and is reset by the next flush request.
@@ -61,7 +61,9 @@ void input_DecoderStartWait( decoder_t * );
 /**
  * Whether buffering has yet to supply a pending paused video picture request.
  * This does not wait: a paused demuxer must keep supplying input to decoders
- * with delayed output. No request, audio and subtitle decoders return false.
+ * with delayed output. Readiness is acknowledged before timestamp conversion;
+ * input must set the clock origin before StopWait releases that picture.
+ * No request, audio and subtitle decoders return false.
  */
 bool input_DecoderIsWaitingForFirstVideo( decoder_t * );
 
diff --git a/src/input/es_out.c b/src/input/es_out.c
index e76a103..9f8ee58 100644
--- a/src/input/es_out.c
+++ b/src/input/es_out.c
@@ -2951,11 +2951,23 @@ static int EsOutControlLocked( es_out_t *out, int i_query, va_list args )
     }
     case ES_OUT_SET_EOS:
     {
+        bool has_video = false;
         for (int i = 0; i < p_sys->i_es; i++) {
             es_out_id_t *id = p_sys->es[i];
-            if (id->p_dec != NULL)
+            if (id->p_dec != NULL) {
                 input_DecoderDrain(id->p_dec);
+                if (id->fmt.i_cat == VIDEO_ES)
+                    has_video = true;
+            }
         }
+        /* Paused input stops demuxing at EOF, even while buffering. A delayed
+         * video callback may not yet have acknowledged its picture, and no
+         * later PCR can complete the wait. Finish the existing forced EOF
+         * path now so that picture uses the final clock origin. Playback and
+         * audio-only inputs keep their ordinary end-of-input handling. */
+        if (p_sys->b_paused && p_sys->b_buffering &&
+            p_sys->p_pgrm != NULL && has_video)
+            EsOutDecodersStopBuffering(out, true);
         return VLC_SUCCESS;
     }
 
-- 
