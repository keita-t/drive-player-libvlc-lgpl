From 87066b649b0ec6c0041871c652f16a24a37b7a5e Mon Sep 17 00:00:00 2001
From: Drive Player <drive-player@localhost>
Date: Fri, 13 Nov 2026 18:53:42 +0900
Subject: [PATCH 123/126] gme: play every track of a file in turn, from its
 start only

A file of a game's music holds its tracks, as many as a few dozen, and
game-music-emu played its first track until it fell silent, which a loop
never does, so a looping track played for ever. Its other tracks were
titles, reached when one fell silent, each with its own length, which the
input reported as the length of the file. A seek within a track had the
emulator play from the start of the track to the time.

Play the file as one item: its tracks one after another from the first,
each ended as game-music-emu's own players end a track, at the length its
file states, or after its introduction and two of its loops, or after two
minutes and a half, with a fade of the length its file states or of eight
seconds. A track that falls silent for six seconds still ends there, so the
length of the file is not known until it is played: report no length and
no position, and take no seek but to the start, which plays the file again
from its first track. The tracks are no longer titles. The time goes on
across them.

A stream decompressed on the way, as VLC's inflate filter decompresses a
gzip-compressed VGZ, has no size, which stopped the file being opened:
read it as a stream of unknown size, up to 16 MiB, as is any file larger
than that refused. A file the emulator cannot load, or that has no track,
is not opened.
---
 modules/demux/gme.c | 202 ++++++++++++++++++++------------------------
 1 file changed, 91 insertions(+), 111 deletions(-)

diff --git a/modules/demux/gme.c b/modules/demux/gme.c
index 6e449cf..e1860fc 100644
--- a/modules/demux/gme.c
+++ b/modules/demux/gme.c
@@ -49,16 +49,35 @@ vlc_module_end ()
 
 #define RATE 48000
 
+/* The largest file the emulator is given. game-music-emu reads a file whole
+ * before it plays; its formats' files are rarely more than a few megabytes, and
+ * a larger one is not read (as many bytes of a stream of unknown size are). */
+#define MAX_SIZE (1 << 24)
+
+/* The fade at the end of a track whose file states none, as game-music-emu's
+ * own players fade. */
+#define DEFAULT_FADE_MS 8000
+
+/*
+ * A file is played as one item, from its start: its tracks one after another,
+ * from the first, and the end of the last is the end of the file. game-music-emu
+ * ends a track at the length its file states, or after its introduction and two
+ * of its loops, or after two minutes and a half, with a fade of the length its
+ * file states or of eight seconds; it ends one sooner where it falls silent for
+ * six seconds. So the length of the file is not known until it has been played,
+ * and none is stated: no length, no position, and no seek but to the start,
+ * where it plays again from its first track. The tracks are not titles: an
+ * input that changed title as one track followed another would report the length
+ * and the position of each track, not of the file.
+ */
 struct demux_sys_t
 {
     Music_Emu   *emu;
     unsigned     track_id;
+    unsigned     track_count;
 
     es_out_id_t *es;
     date_t       pts;
-
-    input_title_t **titlev;
-    unsigned        titlec;
 };
 
 
@@ -67,14 +86,37 @@ static int Control (demux_t *, int, va_list);
 static gme_err_t ReaderStream (void *, void *, int);
 static gme_err_t ReaderBlock (void *, void *, int);
 
+/* Starts a track, to end as game-music-emu ends a track of its file. */
+static void StartTrack (demux_t *demux, unsigned track_id)
+{
+    demux_sys_t *sys = demux->p_sys;
+    int play_ms = 150 * 1000, fade_ms = DEFAULT_FADE_MS;
+
+    gme_info_t *info;
+    if (gme_track_info (sys->emu, &info, track_id) == NULL)
+    {
+        if (info->play_length > 0)
+            play_ms = info->play_length;
+        if (info->fade_length >= 0)
+            fade_ms = info->fade_length;
+        gme_free_info (info);
+    }
+    gme_start_track (sys->emu, track_id);
+    gme_set_fade_msecs (sys->emu, play_ms, fade_ms);
+    sys->track_id = track_id;
+    msg_Dbg (demux, "track %u of %u: %d ms, then a fade of %d ms", track_id + 1,
+             sys->track_count, play_ms, fade_ms);
+}
+
 static int Open (vlc_object_t *obj)
 {
     demux_t *demux = (demux_t *)obj;
     uint64_t size;
 
+    /* A stream decompressed on the way (a gzip-compressed VGZ) has no size */
     if (vlc_stream_GetSize(demux->s, &size))
-        return VLC_EGENERIC;
-    if (size > LONG_MAX /* too big for GME */)
+        size = 0;
+    if (size > MAX_SIZE)
         return VLC_EGENERIC;
 
     /* Auto detection */
@@ -90,7 +132,7 @@ static int Open (vlc_object_t *obj)
     block_t *data = NULL;
     if (size <= 0)
     {
-        data = vlc_stream_Block (demux->s, 1 << 24);
+        data = vlc_stream_Block (demux->s, MAX_SIZE);
         if (data == NULL)
             return VLC_EGENERIC;
     }
@@ -98,24 +140,39 @@ static int Open (vlc_object_t *obj)
     /* Initialization */
     demux_sys_t *sys = malloc (sizeof (*sys));
     if (unlikely(sys == NULL))
+    {
+        if (data)
+            block_Release (data);
         return VLC_ENOMEM;
+    }
 
     sys->emu = gme_new_emu (gme_identify_extension (type), RATE);
     if (sys->emu == NULL)
     {
+        if (data)
+            block_Release (data);
         free (sys);
         return VLC_ENOMEM;
     }
+    gme_err_t err;
     if (data)
     {
-        gme_load_custom (sys->emu, ReaderBlock, data->i_buffer, data);
+        err = gme_load_custom (sys->emu, ReaderBlock, data->i_buffer, data);
         block_Release(data);
     }
     else
     {
-        gme_load_custom (sys->emu, ReaderStream, size, demux->s);
+        err = gme_load_custom (sys->emu, ReaderStream, size, demux->s);
+    }
+    int count = gme_track_count (sys->emu);
+    if (err != NULL || count <= 0)
+    {
+        msg_Err (obj, "cannot load the file: %s", err != NULL ? err : "no track");
+        gme_delete (sys->emu);
+        free (sys);
+        return VLC_EGENERIC;
     }
-    gme_start_track (sys->emu, sys->track_id = 0);
+    sys->track_count = count;
 
     es_format_t fmt;
     es_format_Init (&fmt, AUDIO_ES, VLC_CODEC_S16N);
@@ -137,34 +194,15 @@ static int Open (vlc_object_t *obj)
     date_Init (&sys->pts, RATE, 1);
     date_Set (&sys->pts, 0);
 
-    /* Titles */
-    unsigned n = gme_track_count (sys->emu);
-    sys->titlev = vlc_alloc (n, sizeof (*sys->titlev));
-    if (unlikely(sys->titlev == NULL))
-        n = 0;
-    sys->titlec = n;
-    for (unsigned i = 0; i < n; i++)
-    {
-         input_title_t *title = vlc_input_title_New ();
-         sys->titlev[i] = title;
-         if (unlikely(title == NULL))
-             continue;
-
-         gme_info_t *infos;
-         if (gme_track_info (sys->emu, &infos, i))
-             continue;
-         msg_Dbg (obj, "track %u: %s %d ms", i, infos->song, infos->length);
-         if (infos->length != -1)
-             title->i_length = infos->length * INT64_C(1000);
-         if (infos->song[0])
-             title->psz_name = strdup (infos->song);
-         gme_free_info (infos);
-    }
+    /* Every track ends where StartTrack has it end, the lengths its file
+     * states included: no limit of game-music-emu's own on top. */
+    gme_set_autoload_playback_limit (sys->emu, 0);
+    demux->p_sys = sys;
+    StartTrack (demux, 0);
 
     /* Callbacks */
     demux->pf_demux = Demux;
     demux->pf_control = Control;
-    demux->p_sys = sys;
     return VLC_SUCCESS;
 }
 
@@ -174,9 +212,6 @@ static void Close (vlc_object_t *obj)
     demux_t *demux = (demux_t *)obj;
     demux_sys_t *sys = demux->p_sys;
 
-    for (unsigned i = 0, n = sys->titlec; i < n; i++)
-        vlc_input_title_Delete (sys->titlev[i]);
-    free (sys->titlev);
     gme_delete (sys->emu);
     free (sys);
 }
@@ -209,16 +244,13 @@ static int Demux (demux_t *demux)
 {
     demux_sys_t *sys = demux->p_sys;
 
-    /* Next track */
+    /* Next track, the time going on from where the track before ended */
     if (gme_track_ended (sys->emu))
     {
-        msg_Dbg (demux, "track %u ended", sys->track_id);
-        if (++sys->track_id >= (unsigned)gme_track_count (sys->emu))
+        msg_Dbg (demux, "track %u ended", sys->track_id + 1);
+        if (sys->track_id + 1 >= sys->track_count)
             return 0;
-
-        demux->info.i_update |= INPUT_UPDATE_TITLE;
-        demux->info.i_title = sys->track_id;
-        gme_start_track (sys->emu, sys->track_id);
+        StartTrack (demux, sys->track_id + 1);
     }
 
 
@@ -242,102 +274,50 @@ static int Demux (demux_t *demux)
 }
 
 
-static int Control (demux_t *demux, int query, va_list args)
+/* Plays the file again from its first track. */
+static void Restart (demux_t *demux)
 {
     demux_sys_t *sys = demux->p_sys;
 
+    StartTrack (demux, 0);
+    date_Set (&sys->pts, 0);
+}
+
+static int Control (demux_t *demux, int query, va_list args)
+{
     switch (query)
     {
         case DEMUX_CAN_SEEK:
+            /* To the start only (DEMUX_SET_TIME) */
             *va_arg (args, bool *) = true;
             return VLC_SUCCESS;
 
-        case DEMUX_GET_POSITION:
-        {
-            double *pos = va_arg (args, double *);
-
-            if (unlikely(sys->track_id >= sys->titlec)
-             || (sys->titlev[sys->track_id]->i_length == 0))
-                *pos = 0.;
-            else
-            {
-                int offset = gme_tell (sys->emu);
-
-                *pos = (double)offset
-                    / (double)(sys->titlev[sys->track_id]->i_length / 1000);
-            }
-            return VLC_SUCCESS;
-        }
-
         case DEMUX_SET_POSITION:
         {
             double pos = va_arg (args, double);
-
-            if (unlikely(sys->track_id >= sys->titlec)
-             || (sys->titlev[sys->track_id]->i_length == 0))
-                break;
-
-            int seek = MS_FROM_VLC_TICK(sys->titlev[sys->track_id]->i_length) * pos;
-            if (gme_seek (sys->emu, seek))
+            if (pos > 0.)
                 break;
-            return VLC_SUCCESS;
-        }
-
-        case DEMUX_GET_LENGTH:
-        {
-            int64_t *v = va_arg (args, int64_t *);
-
-            if (unlikely(sys->track_id >= sys->titlec)
-             || (sys->titlev[sys->track_id]->i_length == 0))
-                break;
-            *v = sys->titlev[sys->track_id]->i_length;
+            Restart (demux);
             return VLC_SUCCESS;
         }
 
         case DEMUX_GET_TIME:
         {
             int64_t *v = va_arg (args, int64_t *);
-            *v = gme_tell (sys->emu) * INT64_C(1000);
+            *v = date_Get (&demux->p_sys->pts);
             return VLC_SUCCESS;
         }
 
         case DEMUX_SET_TIME:
         {
-            int64_t v = va_arg (args, int64_t) / 1000;
-            if (v > INT_MAX || gme_seek (sys->emu, v))
-                break;
-            return VLC_SUCCESS;
-        }
-
-        case DEMUX_GET_TITLE_INFO:
-        {
-            input_title_t ***titlev = va_arg (args, input_title_t ***);
-            int *titlec = va_arg (args, int *);
-            *(va_arg (args, int *)) = 0; /* Title offset */
-            *(va_arg (args, int *)) = 0; /* Chapter offset */
-
-            unsigned n = sys->titlec;
-            *titlev = vlc_alloc (n, sizeof (**titlev));
-            if (unlikely(*titlev == NULL))
-                n = 0;
-            *titlec = n;
-            for (unsigned i = 0; i < n; i++)
-                (*titlev)[i] = vlc_input_title_Duplicate (sys->titlev[i]);
-            return VLC_SUCCESS;
-        }
-
-        case DEMUX_SET_TITLE:
-        {
-            int track_id = va_arg (args, int);
-            if (track_id >= gme_track_count (sys->emu))
+            int64_t v = va_arg (args, int64_t);
+            if (v > 0)
                 break;
-            gme_start_track (sys->emu, track_id);
-            demux->info.i_update |= INPUT_UPDATE_TITLE;
-            demux->info.i_title = track_id;
-            sys->track_id = track_id;
+            Restart (demux);
             return VLC_SUCCESS;
         }
     }
 
+    /* No length, position or titles (see demux_sys_t) */
     return VLC_EGENERIC;
 }
