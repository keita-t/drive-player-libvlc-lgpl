+bool matroska_segment_c::LastTimecodeAtTail( uint64 *pi_last_timecode )
+{
+    uint64_t i_stream_size;
+    if( vlc_stream_GetSize( sys.demuxer.s, &i_stream_size ) || i_stream_size == 0 )
+        return false;
+
+    /* The end of the segment's data, or of the file where the file ends first
+     * (cut short) or the segment's size is unknown: there, the last element
+     * may end with the file, in the middle. */
+    uint64_t i_end = i_stream_size;
+    bool b_cut = true;
+    if( segment->IsFiniteSize() && segment->GetEndPosition() <= i_stream_size )
+    {
+        i_end = segment->GetEndPosition();
+        b_cut = false;
     }
+    uint64_t i_first = cluster->GetElementPosition();
+    if( i_first >= i_end )
+        return false;
 
-    // get back to the reading position we were at before looking for a duration
-    es.I_O().setFilePointer( i_current_position, seek_beginning );
+    std::vector<uint64_t> track_numbers;
+    for( tracks_map_t::const_iterator it = tracks.begin(); it != tracks.end(); ++it )
+        track_numbers.push_back( it->first );
+
+    /* Read the end of the data in steps, each before the last, until a step
+     * finds the last cluster, and never before the first cluster. */
+    std::vector<uint8_t> tail;
+    uint64_t i_start = i_end;
+    for( uint64_t i_step : tail_steps )
+    {
+        if( i_start <= i_first )
+            break;
+        uint64_t i_from = i_end - i_first > i_step ? i_end - i_step : i_first;
+        if( i_from >= i_start )
+            continue;
+        size_t i_more = i_start - i_from;
+        tail.insert( tail.begin(), i_more, 0 );
+        es.I_O().setFilePointer( i_from, seek_beginning );
+        if( es.I_O().read( tail.data(), i_more ) != i_more )
+        {
+            msg_Dbg( &sys.demuxer, "could not read the end of the segment" );
+            return false;
+        }
+        i_start = i_from;
+
+        uint64_t i_ticks;
+        if( TailCluster( tail.data(), tail.size(), b_cut, track_numbers ).LastTime( &i_ticks ) )
+        {
+            msg_Dbg( &sys.demuxer, "found the last cluster in the last %zu bytes", tail.size() );
+            *pi_last_timecode = i_ticks * i_timescale;
+            return true;
+        }
+    }
+
+    msg_Dbg( &sys.demuxer, "found no last cluster in the last %zu bytes", tail.size() );
+    return false;
 }
 
