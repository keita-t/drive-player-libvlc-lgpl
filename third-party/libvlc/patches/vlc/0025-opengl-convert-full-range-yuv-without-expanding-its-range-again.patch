From 3b654dceac3760d36420370743084eeb883a88a7 Mon Sep 17 00:00:00 2001
From: Drive Player <drive-player@localhost>
Date: Mon, 12 Oct 2026 18:01:05 +0900
Subject: [PATCH] opengl: convert full-range YUV without expanding its range
 again

The YUV to RGB matrices assume a limited-range source and expand it to
full range. A full-range source, as MJPEG's 4:2:2 pictures are, was then
expanded a second time: its blacks and whites clipped, and a grey coded at
28 and 238 showed at 13 and 255, while stills and the software output were
right. Select the full-range matrices of each colour space when the format
says the source is full range.
---
 .../video_output/opengl/fragment_shaders.c    | 26 ++++++++++++++++---
 1 file changed, 23 insertions(+), 3 deletions(-)

diff --git a/modules/video_output/opengl/fragment_shaders.c b/modules/video_output/opengl/fragment_shaders.c
index be85aec..5276877 100644
--- a/modules/video_output/opengl/fragment_shaders.c
+++ b/modules/video_output/opengl/fragment_shaders.c
@@ -267,17 +267,37 @@ tc_yuv_base_init(opengl_tex_converter_t *tc, GLenum tex_target,
         1.164383530616760,  2.141772270202637,  0.0000,            -1.148145079612732 ,
     };
 
+    /* Full-range input (JPEG and other 0-255 YCbCr) already spans the output
+     * range: converting it as TV range would expand it a second time, crushing
+     * shadows and clipping highlights. Chroma is centred on 128/255 in both. */
+    static const float matrix_bt601_full2full[12] = {
+        1.0,  0.0000,             1.402,             -0.703749019607843 ,
+        1.0, -0.344136286201022, -0.714136286201022,  0.531211330460634 ,
+        1.0,  1.772,              0.0000,            -0.889474509803922 ,
+    };
+    static const float matrix_bt709_full2full[12] = {
+        1.0,  0.0000,             1.5748,            -0.790487843137255 ,
+        1.0, -0.187324272930649, -0.468124272930649,  0.329009466157828 ,
+        1.0,  1.8556,             0.0000,            -0.931438431372549 ,
+    };
+    static const float matrix_bt2020_full2full[12] = {
+        1.0,  0.0000,             1.4746,            -0.740191372549020 ,
+        1.0, -0.164553126843658, -0.571353126843658,  0.369396080282260 ,
+        1.0,  1.8814,             0.0000,            -0.944389019607843 ,
+    };
+
+    const bool full_range = tc->fmt.b_color_range_full;
     const float *matrix;
     switch (yuv_space)
     {
         case COLOR_SPACE_BT601:
-            matrix = matrix_bt601_tv2full;
+            matrix = full_range ? matrix_bt601_full2full : matrix_bt601_tv2full;
             break;
         case COLOR_SPACE_BT2020:
-            matrix = matrix_bt2020_tv2full;
+            matrix = full_range ? matrix_bt2020_full2full : matrix_bt2020_tv2full;
             break;
         default:
-            matrix = matrix_bt709_tv2full;
+            matrix = full_range ? matrix_bt709_full2full : matrix_bt709_tv2full;
     };
 
     for (int i = 0; i < 4; i++) {
-- 
2.55.0

