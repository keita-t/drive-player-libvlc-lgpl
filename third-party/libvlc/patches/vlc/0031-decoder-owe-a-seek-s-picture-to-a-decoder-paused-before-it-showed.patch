From 4b921526e9a13ed1cd19528f041ee69dc9e9b12e Mon Sep 17 00:00:00 2001
From: Drive Player <drive-player@localhost>
Date: Mon, 12 Oct 2026 18:01:06 +0900
Subject: [PATCH] decoder: owe a seek's picture to a decoder paused before it
 showed

A seek asked while playing flushes the decoders without owing them a
picture: frames_countdown is only given to a decoder already paused. A
pause that follows before the new position's picture is shown resets the
countdown, the paused video decoder stops before decoding that picture, and
the position the seek left stays on screen.

Mark a video decoder flushed until it outputs a picture, and give one
paused while marked the picture a paused seek gets.
---
 src/input/decoder.c | 16 +++++++++++++++-
 1 file changed, 15 insertions(+), 1 deletion(-)

diff --git a/src/input/decoder.c b/src/input/decoder.c
index a4e1b6b..0adc228 100644
--- a/src/input/decoder.c
+++ b/src/input/decoder.c
@@ -116,6 +116,9 @@ struct decoder_owner_sys_t
     vlc_tick_t pause_date;
     unsigned frames_countdown;
     bool paused;
+    /* A flush discarded the shown position, whose picture has not been
+     * replaced yet; protected by FIFO. */
+    bool seek_picture_owed;
     /* Last video pause handled, including without a vout; protected by FIFO. */
     bool vout_paused;
 
@@ -1134,6 +1137,7 @@ static int DecoderPlayVideo( decoder_t *p_dec, picture_t *p_picture,
         p_picture->b_force = true;
         p_owner->frames_countdown--;
     }
+    p_owner->seek_picture_owed = false;
     vlc_fifo_Unlock( p_owner->p_fifo );
 
     vlc_mutex_unlock( &p_owner->lock );
@@ -1786,6 +1790,7 @@ static decoder_t * CreateDecoder( vlc_object_t *p_parent,
     p_owner->paused = false;
     p_owner->pause_date = VLC_TICK_INVALID;
     p_owner->frames_countdown = 0;
+    p_owner->seek_picture_owed = false;
 
     p_owner->b_waiting = false;
     p_owner->b_first = true;
@@ -2233,6 +2238,11 @@ void input_DecoderFlush( decoder_t *p_dec )
      * MediaCodec decoder outputs nothing after its end of stream. */
     p_owner->b_draining = false;
 
+    /* The next picture shows the new position, however the input is paused
+     * meanwhile (input_DecoderChangePause). */
+    if( p_owner->fmt.i_cat == VIDEO_ES )
+        p_owner->seek_picture_owed = true;
+
     /* Flush video/spu decoder when paused: increment frames_countdown in order
      * to display one frame/subtitle */
     if( p_owner->paused
@@ -2357,7 +2367,11 @@ void input_DecoderChangePause( decoder_t *p_dec, bool b_paused, vlc_tick_t i_dat
     vlc_fifo_Lock( p_owner->p_fifo );
     p_owner->paused = b_paused;
     p_owner->pause_date = i_date;
-    p_owner->frames_countdown = 0;
+    /* Paused after a seek and before its picture, a video decoder still owes
+     * it, as one sought while paused does (input_DecoderFlush): without it, the
+     * paused decoder stops before decoding the picture, and the position the
+     * seek left stays shown. */
+    p_owner->frames_countdown = b_paused && p_owner->seek_picture_owed ? 1 : 0;
     vlc_fifo_Signal( p_owner->p_fifo );
     vlc_fifo_Unlock( p_owner->p_fifo );
 }
