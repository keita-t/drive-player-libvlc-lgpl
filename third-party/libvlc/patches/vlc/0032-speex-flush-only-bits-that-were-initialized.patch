From 7a1e547c55b8676e61de9324aa1154b9d1506eed Mon Sep 17 00:00:00 2001
From: Drive Player <drive-player@localhost>
Date: Mon, 12 Oct 2026 18:01:06 +0900
Subject: [PATCH] speex: flush only bits that were initialized

The bits are initialized with the headers, but Flush() reset them
regardless: a seek as the input opens, before its first packet, wrote
through an uninitialized pointer and crashed the process. Reset them only
once initialized, as the packetizer path already checks.
---
 modules/codec/speex.c | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/modules/codec/speex.c b/modules/codec/speex.c
index 98cd75d..a146f52 100644
--- a/modules/codec/speex.c
+++ b/modules/codec/speex.c
@@ -620,7 +620,10 @@ static void Flush( decoder_t *p_dec )
 {
     decoder_sys_t *p_sys = p_dec->p_sys;
 
-    speex_bits_reset( &p_sys->bits );
+    /* A flush can come before the headers that initialize the bits: a seek
+     * as the input opens, before its first packet. */
+    if( p_sys->bits.buf_size != 0 )
+        speex_bits_reset( &p_sys->bits );
 
     date_Set( &p_sys->end_date, 0 );
 }
