From 2e6465aeae493bd91361bb3698dc0906eece2e50 Mon Sep 17 00:00:00 2001
From: Drive Player <drive-player@localhost>
Date: Wed, 11 Nov 2026 09:51:22 +0900
Subject: [PATCH] lib: describe the transfer function of a video track

An application that draws a track's pictures itself has to know whether
they are HDR to show them in SDR: a PQ or HLG signal drawn as it is looks
washed out. The input item's track already holds the transfer function
the demuxer read from the container, and the decoder's once it has output
a picture, but the track description an application reads left it out.

Describe it there, as libVLC's video_transfer_func_t value.
---
 include/vlc/libvlc_media.h | 4 ++++
 lib/media.c                | 1 +
 2 files changed, 5 insertions(+)

diff --git a/include/vlc/libvlc_media.h b/include/vlc/libvlc_media.h
index 0195049..ceacafc 100644
--- a/include/vlc/libvlc_media.h
+++ b/include/vlc/libvlc_media.h
@@ -223,6 +223,10 @@ typedef struct libvlc_video_track_t
     libvlc_video_orient_t       i_orientation;
     libvlc_video_projection_t   i_projection;
     libvlc_video_viewpoint_t    pose; /**< Initial view point */
+
+    /** The transfer function the pictures are coded with, as the stream
+     * describes it (a video_transfer_func_t value, 0 when undefined). */
+    unsigned    i_color_transfer;
 } libvlc_video_track_t;
 
 typedef struct libvlc_subtitle_track_t
diff --git a/lib/media.c b/lib/media.c
index 07231c5..22eb7ff 100644
--- a/lib/media.c
+++ b/lib/media.c
@@ -1059,6 +1059,7 @@ libvlc_media_tracks_get( libvlc_media_t *p_md, libvlc_media_track_t *** pp_es )
             p_mes->video->i_sar_den = p_es->video.i_sar_den;
             p_mes->video->i_frame_rate_num = p_es->video.i_frame_rate;
             p_mes->video->i_frame_rate_den = p_es->video.i_frame_rate_base;
+            p_mes->video->i_color_transfer = p_es->video.transfer;
 
             assert( p_es->video.orientation >= ORIENT_TOP_LEFT &&
                     p_es->video.orientation <= ORIENT_RIGHT_BOTTOM );
-- 
