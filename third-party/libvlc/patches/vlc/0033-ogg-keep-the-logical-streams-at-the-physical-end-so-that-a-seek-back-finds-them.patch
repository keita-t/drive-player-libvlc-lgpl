From 09161a9e1c74f967a6d8a25fe40a845d7d7aadef Mon Sep 17 00:00:00 2001
From: Drive Player <drive-player@localhost>
Date: Mon, 12 Oct 2026 18:01:06 +0900
Subject: [PATCH] ogg: keep the logical streams at the physical end so that a
 seek back finds them

When all logical streams have ended, the demuxer deletes them to look for
the next group of a chained stream. At the end of a file there is no next
group, but the streams are gone, and every later seek fails with no
selected seekable stream, leaving the input at its end. A small file is
read to its end soon after it starts, so its seeks failed shortly after.

Keep the finished streams when the physical stream has been read through,
and reset their finished state on a seek.
---
 modules/demux/ogg.c | 28 ++++++++++++++++++++++++++++
 1 file changed, 28 insertions(+)

diff --git a/modules/demux/ogg.c b/modules/demux/ogg.c
index 93252bd..728618a 100644
--- a/modules/demux/ogg.c
+++ b/modules/demux/ogg.c
@@ -137,6 +137,7 @@ static void Ogg_EndOfStream( demux_t *p_demux );
 static void Ogg_LogicalStreamDelete( demux_t *p_demux, logical_stream_t *p_stream );
 static bool Ogg_LogicalStreamResetEsFormat( demux_t *p_demux, logical_stream_t *p_stream );
 static void Ogg_ResetStream( logical_stream_t *p_stream );
+static bool Ogg_AtPhysicalEnd( demux_t *p_demux );
 
 /* */
 static void Ogg_ExtractMeta( demux_t *p_demux, es_format_t *p_fmt, const uint8_t *p_headers, int i_headers );
@@ -297,6 +298,13 @@ static int Demux( demux_t * p_demux )
 
     if ( i_active_streams == 0 )
     {
+        if ( p_sys->i_streams && Ogg_AtPhysicalEnd( p_demux ) )
+        {
+            /* No group follows: keep the finished streams, which a seek back
+             * plays again. Deleted, they leave nothing to seek with. */
+            return VLC_DEMUXER_EOF;
+        }
+
         if ( p_sys->i_streams ) /* All finished */
         {
             msg_Dbg( p_demux, "end of a group of %d logical streams", p_sys->i_streams );
@@ -704,6 +712,20 @@ static int Demux( demux_t * p_demux )
     return VLC_DEMUXER_SUCCESS;
 }
 
+/* Whether the physical stream has been read to its end, with no page left to
+ * sync: no group of logical streams can follow. False when its size is
+ * unknown, as for a radio chaining groups. */
+static bool Ogg_AtPhysicalEnd( demux_t *p_demux )
+{
+    demux_sys_t *p_sys = p_demux->p_sys;
+    uint64_t i_size;
+
+    if( vlc_stream_GetSize( p_demux->s, &i_size ) != VLC_SUCCESS || i_size == 0 )
+        return false;
+    return vlc_stream_Tell( p_demux->s ) >= i_size
+        && p_sys->oy.fill == p_sys->oy.returned;
+}
+
 static void Ogg_ResetStream( logical_stream_t *p_stream )
 {
 #ifdef HAVE_LIBVORBIS
@@ -727,7 +749,13 @@ static void Ogg_ResetStream( logical_stream_t *p_stream )
 static void Ogg_ResetStreamsHelper( demux_sys_t *p_sys )
 {
     for( int i = 0; i < p_sys->i_streams; i++ )
+    {
         Ogg_ResetStream( p_sys->pp_stream[i] );
+        /* A seek leaves the end a stream may have reached: it plays again.
+         * The skeleton ends once, with its headers. */
+        if( p_sys->pp_stream[i] != p_sys->p_skelstream )
+            p_sys->pp_stream[i]->b_finished = false;
+    }
 
     ogg_sync_reset( &p_sys->oy );
     p_sys->i_pcr = VLC_TS_UNKNOWN;
-- 
