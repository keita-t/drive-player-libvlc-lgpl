From a251f37032a9766f2b36e528f22078b2258c1ae8 Mon Sep 17 00:00:00 2001
From: Drive Player <drive-player@localhost>
Date: Wed, 21 Oct 2026 07:40:04 +0900
Subject: [PATCH] vc1: report the time of a VC-1 stream and find its start by
 its time

A VC-1 stream with no container has no index, and its demuxer, which
timed its pictures at a rate from its start, reported no time and
refused every time seek: a player's position stayed at the start for as
long as it played, and a player starting it over from its start by time,
as one does when a window comes, had its decoder flushed while the
stream went on from where it was read.

Report the time of the next picture, unless a seek by position left the
pictures with no time to begin from, and find the start by its time,
timing the pictures from it again, as the demuxers of the other
elementary video streams do.
---
 modules/demux/vc1.c | 40 ++++++++++++++++++++++++++++++++++------
 1 file changed, 34 insertions(+), 6 deletions(-)

diff --git a/modules/demux/vc1.c b/modules/demux/vc1.c
index 5c55646..5d233f4 100644
--- a/modules/demux/vc1.c
+++ b/modules/demux/vc1.c
@@ -60,6 +60,9 @@ vlc_module_end ()
 struct demux_sys_t
 {
     vlc_tick_t  i_dts;
+    /* Whether its pictures are timed from its start: not after a seek
+     * elsewhere, which has no time to begin from. */
+    bool        b_timed;
     es_out_id_t *p_es;
 
     float       f_fps;
@@ -105,6 +108,7 @@ static int Open( vlc_object_t * p_this )
     p_demux->p_sys     = p_sys;
     p_sys->p_es        = NULL;
     p_sys->i_dts       = 0;
+    p_sys->b_timed     = true;
     p_sys->f_fps = var_CreateGetFloat( p_demux, "vc1-fps" );
     if( p_sys->f_fps < 0.001f )
         p_sys->f_fps = 0.0f;
@@ -204,13 +208,37 @@ static int Demux( demux_t *p_demux)
  *****************************************************************************/
 static int Control( demux_t *p_demux, int i_query, va_list args )
 {
-    /* demux_sys_t *p_sys  = p_demux->p_sys; */
+    demux_sys_t *p_sys  = p_demux->p_sys;
     /* FIXME calculate the bitrate */
-    if( i_query == DEMUX_SET_TIME )
-        return VLC_EGENERIC;
+    if( i_query == DEMUX_GET_TIME )
+    {
+        /* Pictures timed at a rate from the start: the time is the next
+         * one's. */
+        if( !p_sys->b_timed )
+            return VLC_EGENERIC;
+        *va_arg( args, vlc_tick_t * ) = p_sys->i_dts;
+        return VLC_SUCCESS;
+    }
+    else if( i_query == DEMUX_SET_TIME )
+    {
+        /* With no index, the start is the one time a picture can be found
+         * at: its pictures are timed from it again. */
+        if( va_arg( args, vlc_tick_t ) != 0 || vlc_stream_Seek( p_demux->s, 0 ) )
+            return VLC_EGENERIC;
+        if( p_sys->p_packetizer->pf_flush )
+            p_sys->p_packetizer->pf_flush( p_sys->p_packetizer );
+        p_sys->i_dts = 0;
+        p_sys->b_timed = true;
+        return VLC_SUCCESS;
+    }
     else
-        return demux_vaControlHelper( p_demux->s,
-                                       0, -1,
-                                       0, 1, i_query, args );
+    {
+        int i_ret = demux_vaControlHelper( p_demux->s,
+                                           0, -1,
+                                           0, 1, i_query, args );
+        if( i_ret == VLC_SUCCESS && i_query == DEMUX_SET_POSITION )
+            p_sys->b_timed = false;
+        return i_ret;
+    }
 }
 
