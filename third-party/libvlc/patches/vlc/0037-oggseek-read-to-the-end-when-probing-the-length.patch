From 979ff61e471857c534b6e8428bacc89b4a4d0c7f Mon Sep 17 00:00:00 2001
From: Drive Player <drive-player@localhost>
Date: Mon, 12 Oct 2026 18:32:14 +0900
Subject: [PATCH] oggseek: read to the end when probing the length

The probe reads from further back each time no page was found, but it
stopped each read short of what it had read before and at the first page
with a granule. A page is only found whole: one that starts before the
bytes read and ends after them, as a second of FLAC does, was never
found, and the length was that of an earlier page.

Read to the end each time and take the greatest granule.
---
 modules/demux/oggseek.c | 27 +++++++--------------------
 1 file changed, 7 insertions(+), 20 deletions(-)

diff --git a/modules/demux/oggseek.c b/modules/demux/oggseek.c
index 6851a6f..5b1994c 100644
--- a/modules/demux/oggseek.c
+++ b/modules/demux/oggseek.c
@@ -246,9 +246,11 @@ void Oggseek_ProbeEnd( demux_t *p_demux )
         return;
     }
 
+    /* Read from further back each time, always to the end: a page is only
+     * found whole, and the last one may start before the bytes read, as a
+     * second of lossless audio does. */
     while( i_pos >= i_lowerbound )
     {
-
         while( i_pos < i_upperbound )
         {
             if ( oy.unsynced )
@@ -257,7 +259,7 @@ void Oggseek_ProbeEnd( demux_t *p_demux )
             buffer = ogg_sync_buffer( &oy, OGGSEEK_BYTES_TO_READ );
             if ( buffer == NULL ) goto clean;
             i_result = vlc_stream_Read( p_demux->s, (void*) buffer, OGGSEEK_BYTES_TO_READ );
-            if ( i_result < 1 ) goto clean;
+            if ( i_result < 1 ) break;
             i_pos += i_result;
             ogg_sync_wrote( &oy, i_result );
 
@@ -276,31 +278,16 @@ void Oggseek_ProbeEnd( demux_t *p_demux )
                     break;
                 }
             }
-            /* We found at least a page with valid granule */
-            if ( i_length > 0 ) break;
         }
 
         if( i_startpos == i_lowerbound ||
             p_sys->i_length != 0 )
             goto clean;
 
-        int64_t i_next_upperbound = __MIN(i_startpos + MIN_PAGE_SIZE, i_upperbound);
-
-        /* Otherwise increase read size, starting earlier */
-        if ( i_backoffset <= MAX_PAGE_SIZE )
-        {
-            i_backoffset <<= 1;
-            i_startpos = i_upperbound - i_backoffset;
-        }
-        else
-        {
-            i_startpos = i_upperbound - MAX_PAGE_SIZE;
-        }
-
-        i_upperbound = i_next_upperbound;
-
-        i_startpos = __MAX( i_startpos, i_lowerbound );
+        i_backoffset <<= 1;
+        i_startpos = __MAX( i_lowerbound, i_upperbound - (int64_t) i_backoffset );
         i_pos = i_startpos;
+        ogg_sync_reset( &oy );
 
         if ( vlc_stream_Seek( p_demux->s, i_pos ) )
             break;
-- 
